{
  "name": "@brugulacivica/sdk",
  "version": "0.1.0",
  "description": "Brújula Cívica TypeScript SDK — fail-closed reads and verification for the Brújula Cívica Soroban contracts (RFC BRUJULA-CIVICA-ARCH-001)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run test/verifier.test.ts test/config.test.ts test/reads.test.ts test/hash.test.ts test/membership.test.ts",
    "test:live": "vitest run test/live.test.ts",
    "test:funding": "vitest run test/funding.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
